{
  "opencollection": "1.0.0",
  "info": {
    "name": "Microsoft Power BI REST Apps Reports API",
    "version": "v1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Reports",
        "type": "folder"
      },
      "items": [
